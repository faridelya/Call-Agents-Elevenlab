# === Application ===
APP_ENV=development
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
BASE_URL=https://your-ngrok-or-domain.com

# === Database ===
DATABASE_URL=postgresql+asyncpg://voxara:voxara_dev@localhost:5432/voxara

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === ElevenLabs ===
ELEVENLABS_API_KEY=sk_...

# === Twilio (platform-level, for users who don't bring their own) ===
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# === OpenAI (for embeddings + post-call summaries) ===
OPENAI_API_KEY=sk-...

# === Encryption (Fernet key for API secrets at rest) ===
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=...

# === Tokens ===
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
