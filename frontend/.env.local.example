# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Create an agent at elevenlabs.io → Conversational AI → Agents
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxx

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Twilio phone number in E.164 format
TWILIO_PHONE_NUMBER=+15550148823

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Public HTTPS/WSS base URL of this server.
# In development use ngrok:  ngrok http 3000  → copy the https://xxx.ngrok-free.app URL
# In production use your real domain.
NEXT_PUBLIC_BASE_URL=https://your-ngrok-or-domain.com
